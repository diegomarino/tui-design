    "bg.raised": "spec: ui.bg_p2 (second raised step; CursorLine)",
    "bg.overlay": "spec: ui.float.bg (floating windows sit at bg_m3)",
    "bg.stripe": "derived: bg.base darkened to 1.06:1 (weakest fill; bg.inset is too strong here, 1.33:1 vs inactive selection 1.16:1) - zebra rules in layout-archetypes §2.4",
