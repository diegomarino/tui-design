    "fg.muted": "spec: ui.fg_dim",
    "fg.faint": "spec: syn.comment; consensus inactive/disabled fujiGray 3/3 (wave)",
    "fg.on-accent": "spec: ui.fg_reverse",
    "border.default": "choice: single focus indicator (FS-09) — Lotus fg_border is 4.26:1 vs 4.59:1 focus",
    "accent.primary": "consensus: accent crystalBlue 2/2 (wave); spec syn.fun",
    "accent.secondary": "choice: syn.keyword violet (categorical contrast with the blue accent)",
    "selection.bg": "spec: ui.bg_visual; ui.pmenu.bg_sel (lotusBlue3) gives 3.51:1 with ui.fg",
    "text-selection.bg": "spec: ui.bg_visual",
    "cursor.bg": "port: extras/kitty cursor = lotusInk2",
    "cursor.fg": "port: extras/kitty cursor_text_color = lotusWhite3",
    "status.error": "spec: diag.error",
    "status.warning": "spec: diag.warning",
    "status.success": "spec: diag.ok",
    "status.info": "spec: diag.info",
    "statusbar.bg": "consensus: statusline bg sumiInk0 (= ui.bg_m3) 2/3 ports (wave)",
    "scrollbar.thumb": "spec: ui.pmenu.bg_thumb",
    "scrollbar.track": "spec: ui.pmenu.bg_sbar",
